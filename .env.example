# GeoVolt ortam değişkenleri örnek dosyası
# Bu dosya örnek amaçlıdır.
# Gerçek .env dosyası GitHub'a gönderilmemelidir.

# Frontend backend bağlantı adresi
VITE_API_BASE_URL=http://localhost:5000

# Backend ortam ayarı
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL/PostGIS bağlantı örneği
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=geovolt_db;Username=postgres;Password=your_password

# JWT kullanılacaksa örnek secret
JWT_SECRET_KEY=change_this_secret_key

# Frontend geliştirme adresi
FRONTEND_URL=http://localhost:5173

# Backend geliştirme adresi
BACKEND_URL=http://localhost:5000